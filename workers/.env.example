GITHUB_TOKEN=replace-with-a-github-token
GITHUB_USERNAME=replace-with-a-github-username
LYFTIX_API_BASE_URL=http://localhost:8080
LYFTIX_WORKER_USERNAME=replace-with-the-owner-username
LYFTIX_WORKER_PASSWORD=replace-with-the-owner-password
GITHUB_API_BASE_URL=https://api.github.com
HTTP_TIMEOUT_SECONDS=10
GITHUB_EVENTS_PER_PAGE=30
GITHUB_MAX_PAGES_PER_RUN=3
GITHUB_INGESTION_INTERVAL_SECONDS=900
WORKER_STATE_PATH=~/.local/state/lyftix/github.json
CODING_SESSIONS_INPUT_PATH=./input/coding-sessions.jsonl
CODING_SESSION_DEFAULT_SOURCE=file
SYSTEM_METRICS_COLLECTION_MODE=local
SYSTEM_METRICS_HOSTNAME=ds-server
SYSTEM_METRICS_SOURCE=host-worker
SYSTEM_METRICS_PROC_PATH=/host-proc
SYSTEM_METRICS_DISK_PATH=/host-disk
SYSTEM_METRICS_HOST_DISK_PATH=/var/lib/lyftix-host-metrics
SYSTEM_METRICS_INTERVAL_SECONDS=60
