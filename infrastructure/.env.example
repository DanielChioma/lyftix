# PostgreSQL
POSTGRES_DB=lyftix_example
POSTGRES_USER=lyftix_example
POSTGRES_PASSWORD=

# Browser-facing application
LYFTIX_CORS_ALLOWED_ORIGINS=https://lyftix.example.test
LYFTIX_SESSION_COOKIE_SECURE=true
LYFTIX_PUBLIC_SCHEME=https
FRONTEND_PORT=8088

# Optional owner bootstrap
# For a fresh bootstrap, supply both values together. Leave both empty when an owner already exists.
LYFTIX_AUTH_BOOTSTRAP_USERNAME=
LYFTIX_AUTH_BOOTSTRAP_PASSWORD=

# Worker authentication and GitHub ingestion
# Populate the credentials and GitHub identity/token before enabling the workers profile.
LYFTIX_WORKER_USERNAME=
LYFTIX_WORKER_PASSWORD=
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_API_BASE_URL=https://api.github.com
WORKER_HTTP_TIMEOUT_SECONDS=10
GITHUB_EVENTS_PER_PAGE=30
GITHUB_MAX_PAGES_PER_RUN=3
GITHUB_INGESTION_INTERVAL_SECONDS=900

# Host-system metrics
SYSTEM_METRICS_HOSTNAME=host.example.test
SYSTEM_METRICS_SOURCE=host-worker
SYSTEM_METRICS_INTERVAL_SECONDS=60
SYSTEM_METRICS_HOST_DISK_PATH=/var/lib/lyftix-host-metrics

# Grafana
# The actual initial admin password belongs in the separate secret file, not this environment file.
GRAFANA_ADMIN_USER=admin
GRAFANA_PORT=3000
GRAFANA_INITIAL_ADMIN_PASSWORD_FILE=./secrets/grafana-initial-admin-password
